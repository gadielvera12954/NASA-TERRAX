{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paridad.schema.json",
  "title": "Archivo de paridad Python ↔ navegador (destino/paridad.json)",
  "description": "1.000 casos de píxel, Sol y resultado esperado, calculados en Python con la regla de esquemas/horizontes_bin.md sobre los mismos bytes que lee el navegador. Erwan los usa en su prueba con Vitest: cada caso tiene que dar lo mismo.",
  "type": "object",
  "required": ["formato", "archivo_horizontes", "sha256_horizontes", "regla", "ancho", "alto", "n_az", "casos", "maqueta", "meta"],
  "properties": {
    "formato": { "const": "TXHZ v1" },
    "archivo_horizontes": { "type": "string" },
    "sha256_horizontes": { "$ref": "comun.schema.json#/$defs/sha256" },
    "regla": { "type": "string" },
    "ancho": { "type": "integer" },
    "alto": { "type": "integer" },
    "n_az": { "type": "integer" },
    "casos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["fila", "col", "az", "el", "k", "byte", "horizonte_deg", "sombra"],
        "properties": {
          "fila": { "type": "integer", "minimum": 0 },
          "col": { "type": "integer", "minimum": 0 },
          "az": { "type": "number", "minimum": 0, "exclusiveMaximum": 360 },
          "el": { "type": "number", "minimum": -90, "maximum": 90 },
          "k": { "type": "integer", "minimum": 0 },
          "byte": { "type": "integer", "minimum": 0, "maximum": 255 },
          "horizonte_deg": { "type": "number" },
          "sombra": { "type": "boolean" },
          "tipo": { "type": "string" }
        }
      }
    },
    "maqueta": { "type": "boolean" },
    "meta": { "$ref": "comun.schema.json#/$defs/meta" }
  }
}
